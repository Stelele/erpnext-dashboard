{
  "App": {
    "FrontendUrl": "https://dashboard.njeremoto.net"
  },
  "Email": {
    "Smtp": {
      "Host": "<Enter as user secret>",
      "Port": 587,
      "Username": "<Enter as user secret>",
      "Password": "<Enter as user secret>",
      "From": "<Enter as user secret>",
      "EnableSsl": true
    },
    "Http": {
      "ApiKey": "<Enter as user secret>",
      "From": "<Enter as user secret>"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MediatR": {
    "LicenseKey": "<Enter as user secret>"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=erpnext.db"
  },
  "R2": {
    "AccountId": "<Enter as user secret>",
    "AccessKeyId": "<Enter as user secret>",
    "SecretAccessKey": "<Enter as user secret>",
    "BackupBucketName": "apps-bucket",
    "PublicBucketName": "public-apps-bucket",
    "CDNBaseUrl": "<Enter as user secret>",
    "SyncIntervalMinutes": 15,
    "RestoreMaxRetries": 3
  },
  "OpenApi": {
    "ServerUrl": "https://api-erp-dashboard.giftmugweni.com"
  },
  "Cors": {
    "AllowedOrigin": "https://dashboard.njeremoto.net"
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  }
}
